# Скопируй этот файл в .env и заполни ключи Google (инструкция: docs/google-setup.md).
# Файл .env не попадает в git и не должен никуда отправляться.

# Порт локального сервера. Если меняешь — поменяй и адрес возврата в Google Cloud.
SERVER_PORT=4100

# Куда вернуть браузер после входа через Google (адрес интерфейса).
APP_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4100/auth/google/callback
